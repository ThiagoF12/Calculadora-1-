import requests
from bs4 import BeautifulSoup

def obter_tarifa(classe_consumo, bandeira):
    """
    Obtém a tarifa de energia do site da CEMIG.

    Args:
        classe_consumo (str): Classe de consumo (e.g., residencial, comercial).
        bandeira (str): Bandeira tarifária (verde, amarela ou vermelha).

    Returns:
        float: Tarifa em R$/kWh.
    """
    url = "https://www.cemig.com.br/tarifas-e-bandeiras"  # URL de exemplo
    response = requests.get(url)
    
    if response.status_code != 200:
        raise ConnectionError("Não foi possível acessar o site da CEMIG.")
    
    soup = BeautifulSoup(response.text, 'html.parser')
    
    # Ajustar de acordo com o site real
    tabela_tarifas = soup.find("table", {"id": "tarifas"})
    linhas = tabela_tarifas.find_all("tr")
    
    for linha in linhas:
        colunas = linha.find_all("td")
        if len(colunas) >= 3:
            if colunas[0].text.strip().lower() == classe_consumo.strip().lower() and colunas[1].text.strip().lower() == bandeira.strip().lower():
                return float(colunas[2].text.replace(",", "."))
    
    raise ValueError("Tarifa não encontrada para os parâmetros fornecidos.")

def calculadora(consumo, classe_consumo, bandeira):
    """
    Calcula o custo com base no consumo e na tarifa obtida automaticamente.

    Args:
        consumo (float): Consumo em kWh.
        classe_consumo (str): Classe de consumo.
        bandeira (str): Bandeira tarifária.

    Returns:
        float: Custo total em R$.
    """
    if consumo < 0:
        raise ValueError("Consumo deve ser um valor positivo.")
    
    tarifa = obter_tarifa(classe_consumo, bandeira)
    return round(consumo * tarifa, 2)

def main():
    """
    Função principal para executar a calculadora.
    """
    print("Bem-vindo à Calculadora de Consumo de Energia!")
    try:
        consumo = float(input("Informe o consumo em kWh: "))
        classe_consumo = input("Informe a classe de consumo (e.g., residencial, comercial): ")
        bandeira = input("Informe a bandeira tarifária (verde, amarela ou vermelha): ")

        custo = calculadora(consumo, classe_consumo, bandeira)
        print(f"O custo total estimado é: R$ {custo}")
    except ValueError as ve:
        print(f"Erro: {ve}")
    except ConnectionError as ce:
        print(f"Erro de conexão: {ce}")
    except Exception as e:
        print(f"Ocorreu um erro inesperado: {e}")

if __name__ == "__main__":
    main()
